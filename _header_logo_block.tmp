.site-logo {
  font-size: 0.9rem;
  font-weight: 800;
  text-transform: uppercase;
  letter-spacing: 0.18em;
  white-space: nowrap;
  display: inline-flex;
  align-items: center;
  gap: 0.55rem;
}

.site-logo-image {
  height: 2rem;
  width: auto;
  object-fit: contain;
  object-position: left center;
  flex-shrink: 0;
}
